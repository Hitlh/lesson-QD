# Copy to .env. Relative paths are resolved against this repository root.
# Existing environment variables override .env; explicit CLI options win.
FRAMESEEK_PROFILE=qv
FRAMESEEK_HOST=127.0.0.1
FRAMESEEK_PORT=8000
QD_DETR_DEVICE=auto
QD_DETR_FEATURE_MODE=slowfast_clip
QD_DETR_ROOT=QD-DETR
LIGHTHOUSE_ROOT=lighthouse
QD_DETR_CLIP_MODEL=models/ViT-B-32.pt
SLOWFAST_CHECKPOINT=models/SLOWFAST_8x8_R50.pkl
# Optional overrides. Leave these commented for profile-dependent defaults.
# QD_DETR_CHECKPOINT=models/qv_model_best.ckpt
# QD_DETR_WINDOW_RANKER=models/window_ranker.pt
# Set QD_DETR_WINDOW_RANKER= to explicitly disable the optional ranker.
QD_DETR_NMS_METHOD=hard
QD_DETR_NMS_THRESHOLD=0.5
QD_DETR_NMS_MIN_SCORE=0
QD_DETR_WINDOW_CLIPS=75
QD_DETR_WINDOW_OVERLAP_CLIPS=15
FEATURE_CHUNK_CLIPS=30
FEATURE_CACHE_SIZE=32
SLOWFAST_BATCH_SIZE=16
MAX_VIDEO_DURATION=600
MAX_UPLOAD_MB=256
VIDEO_STORAGE_DIR=storage
FRONTEND_DIST=frontend/dist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
